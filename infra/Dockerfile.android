FROM node:22-bookworm-slim AS node
FROM eclipse-temurin:8-jdk-jammy AS jdk8
FROM eclipse-temurin:21-jdk-jammy
RUN apt-get update && apt-get install -y --no-install-recommends git curl unzip python3 make gcc g++ openssl && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENV ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk
RUN curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-15859902_latest.zip -o /tmp/android-tools.zip && echo '4e4c464f145a7512b57d088ac6c278c03c9eea610886b35a5e0804e74eedf583  /tmp/android-tools.zip' | sha256sum -c - && mkdir -p /opt/android-sdk/cmdline-tools && unzip -q /tmp/android-tools.zip -d /opt/android-sdk/cmdline-tools && mv /opt/android-sdk/cmdline-tools/cmdline-tools /opt/android-sdk/cmdline-tools/latest && rm /tmp/android-tools.zip
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}
RUN for package in platform-tools platforms/android-37.0 build-tools/37.0.0 ndk/27.3.13750724 ndk/28.2.13676358; do yes | android --no-metrics sdk install "$package" || exit 1; done && test -f /opt/android-sdk/platforms/android-37.0/android.jar
COPY --from=jdk8 /opt/java/openjdk /opt/java/jdk8
ENV JDK8_HOME=/opt/java/jdk8
WORKDIR /app
COPY package*.json tsconfig*.json ./
COPY packages/core packages/core
COPY apps/api apps/api
COPY apps/web/package.json apps/web/package.json
COPY scripts scripts
COPY integrations integrations
RUN npm ci && npm run build -w @studio/core && npm run db:generate && npm run build -w @studio/api && node scripts/prepare-launcher.mjs /launcher && chmod +x /launcher/gradlew && cd /launcher && bash scripts/languagelist_updater.sh
CMD ["npm","run","worker","-w","@studio/api"]
