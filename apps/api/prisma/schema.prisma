generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id String @id @default(cuid())
  name String
  slug String @unique
  icon String?
  customVersion String @default("Custom 1.0")
  draft Json
  importedFrom Json?
  upstreamSnapshot Json?
  modified Boolean @default(false)
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  releases Release[]
  revisions Revision[]
}
model Revision {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number Int
  draft Json
  reason String
  createdAt DateTime @default(now())
  @@unique([projectId, number])
}
model Release {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version String
  bundle Json
  manifest Json
  createdAt DateTime @default(now())
  @@unique([projectId, version])
}
model Job {
  id String @id @default(cuid())
  kind String
  status String @default("queued")
  input Json
  progress Json
  result Json?
  error String?
  cancelRequested Boolean @default(false)
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model Build {
  id String @id @default(cuid())
  status String @default("queued")
  storageKey String?
  sha256 String?
  versionCode Int
  jobId String @unique
  createdAt DateTime @default(now())
  @@unique([versionCode])
}
model DiagnosticReport {
  id String @id @default(cuid())
  projectId String?
  releaseId String?
  kind String
  launcherVersion String
  device Json
  message String
  log String
  status String @default("new")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Audit {
  id String @id @default(cuid())
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
}
