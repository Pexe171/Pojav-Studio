generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  sessions Session[]
}
model Session {
  id String @id
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id String @id @default(cuid())
  name String
  slug String @unique
  icon String?
  customVersion String @default("Custom 1.0")
  draft Json
  importedFrom Json?
  upstreamSnapshot Json?
  modified Boolean @default(false)
  revision Int @default(1)
  personal Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  releases Release[]
  revisions Revision[]
}
model Player {
  id String @id @default(cuid())
  email String? @unique
  passwordHash String?
  name String @default("Visitante")
  createdAt DateTime @default(now())
  sessions PlayerSession[]
  profiles PlayerProfile[]
}
model PlayerSession {
  id String @id
  playerId String
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model PlayerProfile {
  id String @id @default(cuid())
  playerId String
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  provider String
  externalProjectId String
  externalVersionId String
  name String
  icon String?
  favorite Boolean @default(false)
  settings Json
  revision Int @default(1)
  projectId String?
  jobId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([playerId, provider, externalProjectId, externalVersionId])
  @@index([playerId, updatedAt])
  @@index([projectId])
}
model Revision {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number Int
  draft Json
  reason String
  createdAt DateTime @default(now())
  @@unique([projectId, number])
}
model Release {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version String
  bundle Json
  manifest Json
  createdAt DateTime @default(now())
  @@unique([projectId, version])
}
model Job {
  id String @id @default(cuid())
  kind String
  status String @default("queued")
  input Json
  progress Json
  result Json?
  error String?
  cancelRequested Boolean @default(false)
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model Build {
  id String @id @default(cuid())
  status String @default("queued")
  storageKey String?
  sha256 String?
  versionCode Int
  jobId String @unique
  createdAt DateTime @default(now())
  @@unique([versionCode])
}
model DiagnosticReport {
  id String @id @default(cuid())
  projectId String?
  releaseId String?
  kind String
  launcherVersion String
  device Json
  message String
  log String
  status String @default("new")
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model Audit {
  id String @id @default(cuid())
  action String
  entityId String
  detail Json
  createdAt DateTime @default(now())
}
model TelemetryEvent {
  id String @id
  deviceKey String
  sessionId String
  projectId String?
  releaseId String?
  kind String
  launcherVersion String
  device Json
  data Json
  log String
  occurredAt DateTime
  receivedAt DateTime @default(now())
  @@index([deviceKey, occurredAt])
  @@index([projectId, occurredAt])
  @@index([receivedAt])
}
